{
  "name": "rydora",
  "version": "0.1.0",
  "private": true,
  "description": "RYDORA full-stack tricycle booking system",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c green,cyan \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "npm run seed --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
